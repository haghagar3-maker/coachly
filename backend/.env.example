# Coachly Backend — Environment Variables
# Copy this to .env and fill in your values

# Supabase (get from your project settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Groq API (https://console.groq.com)
GROQ_KEY=your-groq-api-key

# Admin secret — used only once to create the first admin account
# POST /api/admin/create with header x-admin-secret: <this value>
ADMIN_SECRET=choose-a-strong-random-string

# Frontend URL for CORS (your Vercel deployment URL)
FRONTEND_URL=https://your-app.vercel.app

# Server port (Railway sets this automatically)
PORT=3001
